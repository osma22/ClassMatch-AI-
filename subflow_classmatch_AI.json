    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\n\nif (!lead.found) {\n  return [{ json: { ok: false, action: 'lookup_lead', data: null, error: lead.error || 'Lead not found' } }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    action: 'lookup_lead',\n    data: {\n      lead_id: lead.lead_id,\n      child_name: lead.child_name,\n      year_group: lead.year_group,\n      subject: lead.subject,\n      preference: lead.preference,\n      weak_areas: lead.weak_areas,\n      email: lead.email,\n      exam_in_months: lead.exam_in_months,\n      availability: lead.availability,\n      status: lead.status\n    },\n    error: null\n  }\n}];"
      },
