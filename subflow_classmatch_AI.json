    {
      "parameters": {
        "jsCode": "const input = $node['Switch on action'].json;\nconst tutors = $input.all().map(i => i.json);\n\nconst tutorList = tutors.map((t, i) =>\n  `Tutor ${i+1}:\\n  Name: ${t.tutor_name}\\n  Subjects: ${t.subjects}\\n  Type: ${t.type}\\n  Available Days: ${t.available_days}\\n  Available Times: ${t.available_times}\\n  Current Group Size: ${t.current_group_size || 0}/3`\n).join('\\n\\n');\n\nconst timetable = tutors.map(t =>\n  `${t.tutor_name} (${t.subjects}) — ${t.available_days} at ${t.available_times} [${t.type}]`\n).join('\\n');\n\nreturn [{\n  json: {\n    child_name:     input.child_name,\n    subject:        input.subject,\n    year_group:     input.year_group,\n    preference:     input.preference,\n    weak_areas:     input.weak_areas,\n    exam_in_months: input.exam_in_months,\n    lead_id:        input.lead_id,\n    email:          input.email,\n    tutor_list:     tutorList,\n    timetable:      timetable\n  }\n}];"
      },
      "id": "b08a812c-5fbe-4e4d-82c0-ecdedf17ede1",
      "name": "Prepare for AI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
        -224
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "GPT-4.1-MINI"
        },
        "messages": {
          "values": [
            {
              "content": "You are a tutor matching expert. Find up to 3 suitable tutors for a student. Return ONLY plain text in the exact format specified. No JSON, no curly braces.\n\nMATCHING RULES:\n- Subject must match\n- Session type must match preference (1:1 or Small Group)\n- For Small Group: Current Group Size must be less than 4\n- Rank from best to least match based on subject fit and availability\n- If 0 tutors match, output NO_MATCH: true only",
              "role": "system"
            },
            {
              "content": "=Find up to 3 matching tutors.\n\nSTUDENT:\n- Name: {{ $json.child_name }}\n- Subject: {{ $json.subject }}\n- Year Group: {{ $json.year_group }}\n- Preference: {{ $json.preference }}\n- Weak Areas: {{ $json.weak_areas }}\n- Exam in: {{ $json.exam_in_months }} months\n\nAVAILABLE TUTORS:\n{{ $json.tutor_list }}\n\nIf matches found output EXACTLY (repeat TUTOR block per match max 3):\n\nMATCH_FOUND: true\nTUTOR:\nrank: 1\ntutor_name: [value]\ntutor_type: [value]\navailable_days: [value]\navailable_times: [value]\nsummary: [2 sentences explaining why this tutor specifically suits this child based on their weak areas and subject needs]\nEND_TUTOR\n\nIf no match output EXACTLY:\nNO_MATCH: true\nRecommand 2/3 teacher who teaches {{ $json.subject }}. Mention their avaibility and summary why this tutor suits this child and take preference from the user."
            }
          ]
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "31ca78b5-34ad-432d-aa3d-46f3b7c332ec",
      "name": "AI Match Tutors",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        48,
        -160
      ],
      "credentials": {
        "openAiApi": {
          "id": "TWxXxCtYWmu5mwYu",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const aiResponse = $input.first().json;\nconst text =\n  aiResponse?.message?.content ||\n  aiResponse?.choices?.[0]?.message?.content ||\n  aiResponse?.text ||\n  aiResponse?.content || '';\n\nconst prep = $node['Prepare for AI'].json;\n\nif (text.includes('NO_MATCH: true')) {\n  return [{\n    json: {\n      match_found: false,\n      tutors: [],\n      timetable: prep.timetable,\n      message: 'No tutors available for the requested slot. Here is the full timetable:\\n\\n' + prep.timetable.split('\\n').map(l => '📅 ' + l).join('\\n')\n    }\n  }];\n}\n\nconst blocks = [...text.matchAll(/TUTOR:([\\s\\S]*?)END_TUTOR/g)];\n\nfunction field(block, key) {\n  const m = block.match(new RegExp(key + ':\\\\s*(.+)'));\n  return m ? m[1].trim() : '';\n}\n\nconst tutors = blocks.map(m => ({\n  rank:            field(m[1], 'rank'),\n  tutor_name:      field(m[1], 'tutor_name'),\n  tutor_email:     field(m[1], 'tutor_email'),\n  tutor_type:      field(m[1], 'tutor_type'),\n  available_days:  field(m[1], 'available_days'),\n  available_times: field(m[1], 'available_times'),\n  summary:         field(m[1], 'summary')\n}));\n\nconst emojis = ['1️⃣','2️⃣','3️⃣'];\nconst message = tutors.map((t, i) =>\n  `${emojis[i]} *${t.tutor_name}* (${t.tutor_type})\\n📅 ${t.available_days} at ${t.available_times}\\n💡 ${t.summary}`\n).join('\\n\\n');\n\nreturn [{\n  json: {\n    match_found: true,\n    tutors,\n    message,\n    timetable: prep.timetable\n  }\n}];"
      },
      "id": "2e7d382f-9d91-40c9-96c6-7c417d80d401",
      "name": "Extract & Format Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        -192
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nreturn [{\n  json: {\n    ok: true,\n    action: 'search_tutors',\n    data: {\n      match_found: r.match_found,\n      tutors: r.tutors,\n      message: r.message,\n      timetable: r.timetable\n    },\n    error: null\n  }\n}];"
      },
