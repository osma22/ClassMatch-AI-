    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\nif (!rows || rows.length === 0) {\n  const leadId = $node['Switch on action'].json.lead_id || '';\n  return [{ json: { found: false, error: 'Lead ID not found: ' + leadId } }];\n}\n\nconst lead = rows[0];\n\nreturn [{\n  json: {\n    found: true,\n    lead_id:        lead.lead_id,\n    child_name:     lead.child_name,\n    child_age:      lead.child_age,\n    year_group:     lead.year_group,\n    subject:        lead.subject,\n    preference:     lead.preference,\n    availability:   lead.availability,\n    weak_areas:     lead.weak_areas || lead.challenges || '',\n    email:          lead.email,\n    exam_in_months: lead.exam_in_months,\n    status:         lead.status\n  }\n}];"
      },
      "id": "b4c98e70-3752-4523-ae7d-2e31cfea5d15",
      "name": "Find Lead by ID",
      "type": "n8n-nodes-base.code",
